# BullMQ worker image — processes the publishing and notification queues.
#
# Bundles lib/queue/worker.ts into a standalone ESM entry point in the builder
# stage and prunes devDependencies so the production runner image carries only
# production node_modules and runs on native `node`.
FROM node:22-alpine AS builder
WORKDIR /app
COPY package.json package-lock.json tsconfig.json ./
RUN npm ci --no-audit --no-fund
COPY lib ./lib
RUN npx esbuild lib/queue/worker.ts \
      --bundle \
      --platform=node \
      --format=esm \
      --packages=external \
      --outfile=/app/worker.mjs \
  && npm prune --omit=dev

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production

RUN addgroup --system --gid 1001 nodejs \
  && adduser --system --uid 1001 worker

COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder --chown=worker:nodejs /app/package.json ./
COPY --from=builder --chown=worker:nodejs /app/worker.mjs ./worker.mjs
COPY --chown=worker:nodejs migrate.mjs ./migrate.mjs
COPY --chown=worker:nodejs drizzle ./drizzle

USER worker

CMD ["node", "worker.mjs"]
