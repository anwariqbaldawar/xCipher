NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"

NEXT_PUBLIC_SITE_URL="http://localhost:3000"

DATABASE_URL="postgresql://user:password@host:5432/postgres"
DIRECT_URL="postgresql://user:password@host:5432/postgres"
# Optional. Without it the console still works and in-app notifications are
# still written -- only email delivery is skipped. NEXTAUTH_URL is used to build
# absolute links in those emails, so set it too if you enable this.
RESEND_API_KEY="re_your_resend_api_key"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret"
EMAIL_FROM_ADDRESS="editor@yourdomain.com"

# Shared secret for the scheduled-publication cron endpoint.
# Generate with: openssl rand -hex 32
# If unset, /api/cron/publish-scheduled refuses every request.
CRON_SECRET="your-cron-secret"

# ── Redis (BullMQ queues + rate limiting) ────────────────────────────────────
# Inside docker-compose.prod.yml the web and worker containers reach Redis over
# the internal Docker network as redis://:${REDIS_PASSWORD}@redis:6379.
# Generate the password with: openssl rand -hex 24
# Redis is NOT exposed publicly — no port is published in production.
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD="your-redis-password"

# ── Article image uploads: Cloudflare R2 ─────────────────────────────────────
# Without these the editor's Upload tab reports "not configured" and only the
# Image URL tab works. The public base is the domain the bucket is served from
# (a custom domain, or the r2.dev subdomain) with no trailing slash -- it is
# also what next.config.ts and lib/sanitize.ts derive the allowed host from, so
# an upload to an unlisted host would be stripped on save.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="xsypher-media"
NEXT_PUBLIC_R2_PUBLIC_BASE="https://media.example.com"

# ── Avatar uploads: Cloudinary ───────────────────────────────────────────────
# The cloud name is duplicated as NEXT_PUBLIC_ on purpose: lib/sanitize.ts runs
# in the browser as well as on the server, and a server-only variable would
# make the client compute a narrower allow-list than the server enforces.
CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
