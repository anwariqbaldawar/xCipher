# ─────────────────────────────────────────────────────────────────────────────
# xSypher Production Caddyfile (Oracle Cloud ARM64 + Cloudflare Origin TLS)
#
# Place at /etc/caddy/Caddyfile on the Oracle Ubuntu host and reload with:
#   sudo systemctl reload caddy
#
# Preserves the incoming Host header so Next.js middleware and host-based
# rewrites in next.config.ts route apex, admin and preview subdomains properly.
# ─────────────────────────────────────────────────────────────────────────────

www.xsypher.com {
    redir https://xsypher.com{uri} permanent
}

xsypher.com {
    encode zstd gzip

    reverse_proxy 127.0.0.1:3000 {
        header_up Host {host}
        header_up X-Forwarded-Proto {scheme}
        health_uri /api/healthz
        health_interval 30s
        health_timeout 5s
    # NOTE (audit BE-007): use /api/healthz (liveness, always 200 while the app
    # serves) for proxy health checks. /api/health returns 503 whenever Redis
    # degrades, which would make Caddy drop the only upstream and 502 the whole
    # site over a cache/queue blip. Keep /api/health for uptime monitors.
    }
}

admin.xsypher.com, preview.xsypher.com {
    encode zstd gzip

    header {
        X-Robots-Tag "noindex, nofollow"
    }

    reverse_proxy 127.0.0.1:3000 {
        header_up Host {host}
        header_up X-Forwarded-Proto {scheme}
        health_uri /api/healthz
        health_interval 30s
        health_timeout 5s
    }
}
